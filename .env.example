# จาก LiveKit Cloud → Settings → API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Neon Postgres — ถ้าไม่ใส่ ข้อมูลกิลด์/เลเวลจะอยู่ในหน่วยความจำและหายเมื่อรีสตาร์ท
DATABASE_URL=

# ลายเซ็น token ผู้เล่น (กิลด์/ลานฝึก) — สุ่มยาว 32 ตัวขึ้นไป และห้ามเปลี่ยนหลังเปิดใช้จริง ไม่งั้นผู้เล่นทุกคนจะกลายเป็นคนใหม่
GUILD_SECRET=

# (ไม่บังคับ) ทดสอบลานฝึก: ให้หีบ/วิญญาณเกิดทุก 20–30 วินาที แทน 10–15 นาที — อย่าใส่บน production
# HUB_EVENT_GAP_SEC=20-30
